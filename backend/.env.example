# Read only by the Python backend. Never put this key in a VITE_* variable.
OPENAI_API_KEY=
# Choose a model available to your OpenAI project; this value can be changed anytime.
OPENAI_MODEL=gpt-5.4-mini

DATABASE_PATH=./data/mutual_aid.sqlite3
ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
MAX_AGENT_TURNS=5
MAX_MESSAGE_CHARS=12000
REQUESTS_PER_MINUTE=12
AUTH_SESSION_DAYS=30
AUTH_COOKIE_NAME=mutual_aid_session
AUTH_COOKIE_SECURE=false

# Configure a Google OAuth web client and register this exact redirect URI in Google Cloud.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/connectors/google_calendar/callback
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep stable across restarts; changing it invalidates stored connector credentials.
CONNECTOR_TOKEN_ENCRYPTION_KEY=
